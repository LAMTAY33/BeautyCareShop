@model List<BeautyCareShop.Models.Product>
@{ ViewData["Title"] = "Sản phẩm"; }
<section class="container py-5">
    <div class="section-heading"><div><span class="eyebrow">LUMIPHUX SHOP</span><h1>Sản phẩm</h1></div><p>Khám phá bộ sưu tập Health & Beauty Care.</p></div>
    <form class="search-panel row g-2 mb-4" method="get">
        <div class="col-lg-6 position-relative"><input id="liveSearch" name="search" value="@ViewBag.Search" class="form-control form-control-lg" placeholder="Tìm sản phẩm, SKU..." autocomplete="off" /><div id="suggestions" class="suggestions"></div></div>
        <div class="col-lg-3"><select class="form-select form-select-lg" name="category"><option value="">Tất cả danh mục</option>@foreach (var c in (ViewBag.Categories as List<BeautyCareShop.Models.Category> ?? [])){<option value="@c.Slug" selected="@(ViewBag.Category == c.Slug ? "selected" : null)">@c.Name</option>}</select></div>
        <div class="col-lg-2"><input class="form-control form-control-lg" name="maxPrice" value="@ViewBag.MaxPrice" type="number" placeholder="Giá tối đa" /></div>
        <div class="col-lg-1"><button class="btn btn-dark btn-lg w-100">Lọc</button></div>
    </form>
    @if (Model.Count == 0) { <div class="empty-state"><h3>Không tìm thấy sản phẩm</h3><p class="text-muted">Thử từ khóa hoặc bộ lọc khác.</p></div> }
    <div class="row g-4">
    @foreach (var p in Model)
    {
        <div class="col-sm-6 col-lg-3"><article class="product-card"><div class="product-image"><span class="badge-lpx">@(p.SalePrice.HasValue ? "SALE" : "LPX")</span><a href="/Shop/Details?slug=@p.Slug"><img src="@p.ThumbnailUrl" alt="@p.Name" loading="lazy" onerror="this.src='/images/product-placeholder.svg';" /></a></div><div class="product-body"><small>@p.Category?.Name</small><h3><a href="/Shop/Details?slug=@p.Slug">@p.Name</a></h3><div class="stars">★★★★★ <span>(@p.ReviewCount)</span></div><div class="price">@((p.SalePrice ?? p.Price).ToString("N0"))₫ @if(p.SalePrice.HasValue){<del>@p.Price.ToString("N0")₫</del>}</div><form asp-controller="Cart" asp-action="Add" method="post" class="mt-3">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@p.Id" /><button class="btn btn-dark w-100" @(p.StockQuantity == 0 ? "disabled" : null)>@(p.StockQuantity == 0 ? "Hết hàng" : "Thêm vào giỏ")</button></form></div></article></div>
    }
    </div>
</section>
@section Scripts { <script src="~/js/search.js" asp-append-version="true"></script> }
