@model List<BeautyCareShop.Models.Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<section class="container py-5">
    <div class="section-heading">
        <div>
            <span class="eyebrow">LUMIPHUX SHOP</span>
            <h1>Sản phẩm</h1>
        </div>
        <p>Khám phá bộ sưu tập Health & Beauty Care.</p>
    </div>

    <form class="search-panel row g-2 mb-4" method="get">
        <div class="col-lg-6 position-relative">
            <input id="liveSearch" name="search" value="@ViewBag.Search" class="form-control form-control-lg" placeholder="Tìm sản phẩm, SKU..." autocomplete="off" />
            <div id="suggestions" class="suggestions"></div>
        </div>
        <div class="col-lg-3">
            <select class="form-select form-select-lg" name="category">
                <option value="">Tất cả danh mục</option>
                @foreach (var c in (ViewBag.Categories as List<BeautyCareShop.Models.Category> ?? []))
                {
                    <option value="@c.Slug" selected="@(ViewBag.Category == c.Slug ? "selected" : null)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-lg-2">
            <input class="form-control form-control-lg" name="maxPrice" value="@ViewBag.MaxPrice" type="number" placeholder="Giá tối đa" />
        </div>
        <div class="col-lg-1">
            <button class="btn btn-dark btn-lg w-100">Lọc</button>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h3>Không tìm thấy sản phẩm</h3>
            <p class="text-muted">Thử từ khóa hoặc bộ lọc khác.</p>
        </div>
    }

    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-sm-6 col-lg-3">
                <article class="product-card h-100 d-flex flex-column justify-content-between p-3 border rounded shadow-sm">
                    <div>
                        <div class="product-image position-relative mb-2 text-center">
                            <span class="badge bg-dark position-absolute top-0 start-0 m-2">
                                @(p.SalePrice.HasValue ? "SALE" : "LPX")
                            </span>
                            <a href="/Shop/Details?slug=@p.Slug">
                                <img src="@p.ThumbnailUrl" alt="@p.Name" class="img-fluid rounded" style="max-height: 200px; object-fit: cover;" loading="lazy" onerror="this.src='/images/product-placeholder.svg';" />
                            </a>
                        </div>

                        <div class="product-body">
                            <small class="text-muted d-block mb-1">@p.Category?.Name</small>
                            <h5 class="product-title fs-6">
                                <a href="/Shop/Details?slug=@p.Slug" class="text-decoration-none text-dark fw-bold">@p.Name</a>
                            </h5>

                            <!-- Đánh giá sao -->
                            <div class="stars text-warning small mb-1">
                                ★★★★★ <span class="text-muted">(@p.ReviewCount đánh giá)</span>
                            </div>

                            <!-- HIỂN THỊ SỐ LƯỢNG TỒN KHO THỰC TẾ TẠI ĐÂY -->
                            <div class="stock-info small mb-2">
                                @if (p.StockQuantity > 0)
                                {
                                    <span class="text-success fw-semibold">
                                        <i class="bi bi-box-seam"></i> Còn lại: <strong>@p.StockQuantity</strong> sản phẩm
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">
                                        <i class="bi bi-x-circle"></i> Tạm hết hàng
                                    </span>
                                }
                            </div>

                            <!-- Giá bán -->
                            <div class="price mb-3">
                                <span class="fs-5 fw-bold text-danger">@((p.SalePrice ?? p.Price).ToString("N0"))₫</span>
                                @if (p.SalePrice.HasValue)
                                {
                                    <del class="text-muted small ms-1">@p.Price.ToString("N0")₫</del>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Form thêm vào giỏ hàng -->
                    <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@p.Id" />
                        <button class="btn btn-dark w-100" @(p.StockQuantity <= 0 ? "disabled" : null)>
                            @(p.StockQuantity <= 0 ? "Hết hàng" : "Thêm vào giỏ")
                        </button>
                    </form>
                </article>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/search.js" asp-append-version="true"></script>
}