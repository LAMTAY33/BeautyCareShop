@{ ViewData["Title"]="Quên mật khẩu"; }
<section class="container"><div class="auth-card"><span class="eyebrow">ACCOUNT</span><h1>Quên mật khẩu</h1><p class="text-muted">Nhập email để nhận hướng dẫn đặt lại mật khẩu.</p><form asp-action="ForgotPassword" method="post">@Html.AntiForgeryToken()<div class="mb-3"><input class="form-control" type="email" name="email" placeholder="you@example.com" required/></div><button class="btn btn-dark w-100">Gửi yêu cầu</button></form></div></section>
