@model BeautyCareShop.ViewModels.CheckoutVm
@{ ViewData["Title"] = "Thanh toán"; }
<section class="container py-5">
    <div class="section-heading mb-4">
        <div><span class="eyebrow">CHECKOUT</span><h1>Thanh toán</h1></div>
        <p>An toàn, nhanh chóng và minh bạch.</p>
    </div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="checkout-card">
                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="CustomerName" class="form-label">Họ và tên</label><input asp-for="CustomerName" class="form-control form-control-lg" /></div>
                        <div class="col-md-6"><label asp-for="Phone" class="form-label">Số điện thoại</label><input asp-for="Phone" class="form-control form-control-lg" /></div>
                        <div class="col-12"><label asp-for="ShippingAddress" class="form-label">Địa chỉ giao hàng</label><textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea></div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Phương thức thanh toán</label>
                            <div class="payment-method-grid checkout-method-grid">
                                <label><input type="radio" name="PaymentMethod" value="COD" checked /><span><b>💵 Tiền mặt</b><small>Thanh toán khi nhận hàng</small></span></label>
                                <label><input type="radio" name="PaymentMethod" value="QR" /><span><b>▦ Mã QR</b><small>VietQR / MoMo / ZaloPay / ShopeePay</small></span></label>
                                <label><input type="radio" name="PaymentMethod" value="Card" /><span><b>💳 Thẻ</b><small>Visa / Mastercard demo</small></span></label>
                            </div>
                        </div>
                        <div class="col-12" id="qrProviderBox" style="display:none">
                            <label asp-for="PaymentProvider" class="form-label">Chọn kênh QR</label>
                            <select asp-for="PaymentProvider" class="form-select form-select-lg">
                                <option value="VietQR">VietQR / Ngân hàng</option>
                                <option value="MoMo">MoMo</option>
                                <option value="ZaloPay">ZaloPay</option>
                                <option value="ShopeePay">ShopeePay</option>
                            </select>
                        </div>
                        <div class="col-md-8"><label asp-for="VoucherCode" class="form-label">Mã giảm giá</label><input asp-for="VoucherCode" class="form-control" placeholder="Ví dụ LPX10" /></div>
                    </div>
                    <div class="payment-hint mt-4"><strong>10 phút giữ chỗ:</strong> đơn QR/thẻ được giữ tồn kho trong 10 phút. Sau thời gian này, đơn hết hạn và tồn kho được tự động hoàn lại.</div>
                    <button class="btn btn-dark btn-lg mt-4">Đặt hàng</button>
                </form>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="checkout-side">
                <span class="eyebrow">LUMIPHUX</span>
                <h3>Thanh toán an tâm</h3>
                <p class="text-muted">Thông tin thẻ demo không được lưu. Khi triển khai thật, hãy tích hợp cổng thanh toán chính thức.</p>
                <div class="checkout-trust"><span>✓</span> Bảo mật dữ liệu</div>
                <div class="checkout-trust"><span>✓</span> Kiểm tra tồn kho server-side</div>
                <div class="checkout-trust"><span>✓</span> Theo dõi đơn hàng</div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
<script>
(() => {
    const box = document.getElementById('qrProviderBox');
    document.querySelectorAll('input[name="PaymentMethod"]').forEach(x => x.addEventListener('change', () => {
        box.style.display = document.querySelector('input[name="PaymentMethod"]:checked')?.value === 'QR' ? 'block' : 'none';
    }));
})();
</script>
}
