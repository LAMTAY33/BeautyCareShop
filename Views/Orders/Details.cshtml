@model BeautyCareShop.Models.Order
@{ ViewData["Title"] = Model.OrderCode; }
<section class="container py-5"><span class="eyebrow">ORDER DETAIL</span><h1>@Model.OrderCode</h1><p class="text-muted">Trạng thái: <b>@Model.Status</b> · @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><div class="card p-4 mt-4"><h5>Sản phẩm</h5>@foreach(var item in Model.Items){<div class="d-flex justify-content-between border-bottom py-3"><span>@item.ProductName × @item.Quantity</span><b>@item.LineTotal.ToString("N0")₫</b></div>}<div class="d-flex justify-content-between pt-3"><strong>Tổng</strong><strong>@Model.TotalAmount.ToString("N0")₫</strong></div>@if(!string.IsNullOrWhiteSpace(Model.CancellationReason)){<div class="alert alert-warning mt-3">Lý do hủy: @Model.CancellationReason</div>}</div></section>
