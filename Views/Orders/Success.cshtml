@model BeautyCareShop.Models.Order
@{ ViewData["Title"] = "Đặt hàng thành công"; }
<section class="container py-5">
    <div class="success-page" data-aos="zoom-in">
        <div class="success-page-icon">✓</div>
        <span class="eyebrow">ORDER CONFIRMED</span>
        <h1>Đặt hàng thành công</h1>
        <p class="lead text-muted">Cảm ơn bạn đã mua sắm tại LUMIPHUX. Đơn hàng <strong>@Model.OrderCode</strong> đã được ghi nhận.</p>
        <div class="success-order-grid">
            <div><span>Mã đơn</span><strong>@Model.OrderCode</strong></div>
            <div><span>Tổng tiền</span><strong>@Model.TotalAmount.ToString("N0")₫</strong></div>
            <div><span>Thanh toán</span><strong>@Model.PaymentMethod</strong></div>
            <div><span>Trạng thái</span><strong>@Model.Status</strong></div>
        </div>
        <div class="d-flex justify-content-center gap-2 flex-wrap mt-4">
            <a class="btn btn-dark btn-lg" href="/Orders/Details/@Model.Id">Xem đơn hàng</a>
            <a class="btn btn-outline-dark btn-lg" href="/">Về trang chủ</a>
        </div>
    </div>
</section>
